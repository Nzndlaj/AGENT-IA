    {
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const item = $input.item.json;\nconst output = item.output || '';\n\n// Récupérer le chatId depuis les noeuds précédents\nlet chatId = '';\ntry { chatId = $('Set').item.json.chatId; } catch(e) {}\nif (!chatId) { try { chatId = $('Code').item.json.chatId; } catch(e) {} }\n\n// Regex pour détecter les URLs DALL-E (OpenAI Azure CDN)\nconst dalleRegex = /https?:\\/\\/oaidalleapiprodscus\\.blob\\.core\\.windows\\.net\\/[^\\s<>\"'\\)\\]]+/gi;\n// Regex pour détecter toute URL d'image générique\nconst imgRegex = /https?:\\/\\/[^\\s<>\"'\\)\\]]+\\.(?:png|jpg|jpeg|gif|webp)(?:[?#][^\\s<>\"'\\)\\]]*)?/gi;\n\nconst dalleMatches = output.match(dalleRegex);\nconst imgMatches = output.match(imgRegex);\n\nlet imageUrl = null;\nif (dalleMatches && dalleMatches.length > 0) {\n  imageUrl = dalleMatches[0];\n} else if (imgMatches && imgMatches.length > 0) {\n  imageUrl = imgMatches[0];\n}\n\n// Construire la légende: texte sans l'URL\nlet caption = output\n  .replace(dalleRegex, '')\n  .replace(imgRegex, '')\n  .replace(/\\n{3,}/g, '\\n\\n')\n  .trim();\n\nif (!caption || caption.length < 3) {\n  caption = '🎨 Image générée par DALL-E 3';\n}\nif (caption.length > 1024) {\n  caption = caption.substring(0, 1021) + '...';\n}\n\nreturn [{ json: {\n  output,\n  imageUrl,\n  hasImage: imageUrl !== null,\n  caption,\n  chatId\n} }];"
      },
