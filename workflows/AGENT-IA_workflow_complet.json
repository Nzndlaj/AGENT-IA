    {
      "parameters": {
        "toolDescription": "Génère une image avec DALL-E 3. Retourne un JSON avec data[0].url contenant l'URL de l'image",
        "method": "POST",
        "url": "https://api.openai.com/v1/images/generations",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpBearerAuth",
        "sendBody": true,
        "contentType": "json",
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ model: 'dall-e-3', prompt: $fromAI('prompt', 'Detailed image description in English', 'string'), n: 1, size: '1024x1024', response_format: 'url' }) }}",
        "options": {}
      },
      "id": "01657135-2fbe-4f2e-b467-86a36f5322d6",
      "name": "Generer_Image",
      "type": "n8n-nodes-base.httpRequestTool",
      "typeVersion": 4.4,
      "position": [1820, 520],
      "credentials": {
        "httpBearerAuth": {
          "id": "",
          "name": "OpenAI Bearer Auth"
        }
      }
    },
    {
      "parameters": {
        "options": {
          "gl": "fr",
          "hl": "fr"
        }
      },
      "id": "serpapi-tool-001",
      "name": "Recherche_Web",
      "type": "@n8n/n8n-nodes-langchain.toolSerpApi",
      "typeVersion": 1,
      "position": [1960, 520],
      "credentials": {
        "serpApi": {
          "id": "",
          "name": "SerpAPI"
        }
      }
    },
    {
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "// ============================================================\n// DETECTER IMAGE ET PREPARER SORTIE TELEGRAM\n// ============================================================\n\nconst item = $input.item.json;\nconst output = String(item.output || '').trim();\nconst intermediateSteps = Array.isArray(item.intermediateSteps) ? item.intermediateSteps : [];\n\n// --- 1) Récupérer chatId depuis Telegram Trigger (toujours fiable) ---\nlet chatId = '';\ntry {\n  chatId = $('Telegram Trigger').item.json.message.chat.id.toString();\n} catch (e) {\n  chatId = '';\n}\n\n// --- 2) Extraire l'URL DALL-E ---\nlet imageUrl = null;\n\n// Stratégie A: parser les intermediateSteps (appels d'outils de l'agent)\nfor (const step of intermediateSteps) {\n  const toolName = (step.action && step.action.tool) ? String(step.action.tool) : '';\n  const obs = step.observation;\n  if (!obs) continue;\n  \n  // Tenter parse JSON pour trouver data[0].url\n  try {\n    const parsed = typeof obs === 'string' ? JSON.parse(obs) : obs;\n    if (parsed && parsed.data && Array.isArray(parsed.data) && parsed.data[0] && parsed.data[0].url) {\n      imageUrl = parsed.data[0].url;\n      break;\n    }\n  } catch (e) {\n    // Pas du JSON, extraire URL par regex\n    const m = String(obs).match(/https?:\\/\\/oaidalleapiprodscus\\.blob\\.core\\.windows\\.net\\/[^\\s\"'\\)\\]]+/);\n    if (m) { imageUrl = m[0]; break; }\n  }\n}\n\n// Stratégie B (fallback): chercher l'URL dans le texte de réponse de l'agent\nif (!imageUrl && output) {\n  const dalleRegex = /https?:\\/\\/oaidalleapiprodscus\\.blob\\.core\\.windows\\.net\\/[^\\s<>\"'\\)\\]]+/i;\n  const imgRegex = /https?:\\/\\/[^\\s<>\"'\\)\\]]+\\.(?:png|jpg|jpeg|gif|webp)(?:[?#][^\\s<>\"'\\)\\]]*)?/i;\n  const dm = output.match(dalleRegex);\n  if (dm) imageUrl = dm[0];\n  else {\n    const im = output.match(imgRegex);\n    if (im) imageUrl = im[0];\n  }\n}\n\n// --- 3) Construire la légende (texte sans les URLs) ---\nlet caption = output\n  .replace(/https?:\\/\\/oaidalleapiprodscus\\.blob\\.core\\.windows\\.net\\/[^\\s<>\"'\\)\\]]+/gi, '')\n  .replace(/https?:\\/\\/[^\\s<>\"'\\)\\]]+\\.(?:png|jpg|jpeg|gif|webp)(?:[?#][^\\s<>\"'\\)\\]]*)?/gi, '')\n  .replace(/\\n{3,}/g, '\\n\\n')\n  .trim();\n\nif (!caption || caption.length < 2) {\n  caption = imageUrl ? '🎨 Image générée' : '';\n}\nif (caption.length > 1024) {\n  caption = caption.substring(0, 1021) + '...';\n}\n\n// --- 4) Texte final pour sendMessage (jamais vide) ---\nlet finalText = output;\nif (!finalText || finalText.length === 0) {\n  finalText = 'Désolé, je n\\'ai pas pu générer de réponse.';\n}\nif (finalText.length > 4096) {\n  finalText = finalText.substring(0, 4093) + '...';\n}\n\nreturn [{\n  json: {\n    output: finalText,\n    imageUrl: imageUrl,\n    hasImage: Boolean(imageUrl && chatId),\n    caption: caption,\n    chatId: chatId\n  }\n}];"
      },
